{
  "name": "kolha",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch dev-server.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy ./dist",
    "deploy:worker": "wrangler deploy",
    "db:init": "wrangler d1 execute kolha-db --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute kolha-db --local --file=./seed.sql",
    "db:init:remote": "wrangler d1 execute kolha-db --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute kolha-db --remote --file=./seed.sql",
    "seed:local": "tsx scripts/seed-local.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.4",
    "chart.js": "^4.4.7",
    "react-chartjs-2": "^5.3.0",
    "lucide-react": "0.441.0",
    "browser-image-compression": "^2.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@hono/node-server": "^1.13.7",
    "@types/node": "^22.13.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.5",
    "autoprefixer": "10.5.4",
    "concurrently": "^9.1.2",
    "postcss": "8.5.25",
    "tailwindcss": "3.4.19",
    "tsx": "^4.19.3",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "wrangler": "^4.118.0"
  }
}
